# AegisGate configuration (pydantic-settings, prefix AEGISGATE_)
# Copy to .env and adjust. Everything below has an offline-safe default.

# "echo" runs the deterministic offline EchoMockClient (no network, no keys).
# "openai" uses the OpenAI-compatible client (any /v1/chat/completions server).
AEGISGATE_LLM_MODE=echo

# OpenAI-compatible endpoint + key (only used when LLM_MODE=openai)
AEGISGATE_OPENAI_BASE_URL=https://api.openai.com/v1
AEGISGATE_OPENAI_API_KEY=
AEGISGATE_OPENAI_TIMEOUT_S=30

# Custom model registry (YAML). Defaults to the bundled registry.
# AEGISGATE_REGISTRY_PATH=./my_models.yaml

# Auth: "Bearer <token>" -> tenant. Comma list of "token:tenant" pairs.
# Empty = the bearer token itself is used as the tenant id.
AEGISGATE_TENANT_TOKENS=sk-demo:demo
AEGISGATE_DEFAULT_TENANT=public

# Rate limiting (token bucket per tenant+model)
AEGISGATE_RATE_LIMIT_CAPACITY=10
AEGISGATE_RATE_LIMIT_REFILL_PER_SEC=2

# Circuit breaker
AEGISGATE_BREAKER_FAILURE_THRESHOLD=5
AEGISGATE_BREAKER_RECOVERY_TIMEOUT_S=30
AEGISGATE_BREAKER_HALF_OPEN_PROBES=2

# Retry (exponential backoff, full jitter)
AEGISGATE_RETRY_MAX_RETRIES=2
AEGISGATE_RETRY_BASE_DELAY_S=0.05
AEGISGATE_RETRY_MAX_DELAY_S=1.0

# Request hedging
AEGISGATE_HEDGING_ENABLED=true
AEGISGATE_HEDGE_DELAY_S=0.25
AEGISGATE_HEDGE_P95_THRESHOLD_MS=1500

# Semantic cache (two-tier: exact hash + embedding cosine)
AEGISGATE_CACHE_ENABLED=true
AEGISGATE_CACHE_TTL_S=3600
AEGISGATE_CACHE_MAX_ENTRIES=256
AEGISGATE_CACHE_SEMANTIC_THRESHOLD=0.92

# Budgets (USD) applied per tenant
AEGISGATE_DAILY_SOFT=5
AEGISGATE_DAILY_HARD=10
AEGISGATE_MONTHLY_SOFT=50
AEGISGATE_MONTHLY_HARD=100

# Feature flags persistence (JSON)
# AEGISGATE_FLAGS_PATH=./aegisgate_flags.json

# Uvicorn (for `python -m aegisgate.gateway.app`)
AEGISGATE_HOST=0.0.0.0
AEGISGATE_PORT=8000

# Agent tool & MCP firewall (deterministic tool-call inspection)
AEGISGATE_TOOLS_FIREWALL_ENABLED=false
# AEGISGATE_TOOLS_POLICY_PATH=policies/example_policy.yaml

# PII round-trip: "off" (default) or "anonymize" (pseudonymize requests,
# restore originals in responses)
AEGISGATE_PII_MODE=off
